    <widget class="QWidget" name="page_6">
     <property name="styleSheet">
      <string notr="true">
QWidget#page_6 {
    background-color: #090909;
}
QLabel#page6Title {
    color: #a2a2a6;
    font-family: &quot;Segoe UI&quot;;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 2px;
    background-color: transparent;
}
QWidget#can1_util_bar_1, QWidget#can1_util_bar_2, QWidget#can1_util_bar_3, QWidget#can1_util_bar_4 {
    background-color: #10d96f;
    border: 2px solid #29363d;
    border-radius: 14px;
}
QLabel#barPercentStyle {
    color: #09170f;
    font-family: &quot;Segoe UI&quot;;
    font-size: 12px;
    font-weight: 600;
    background-color: transparent;
}
QLabel#canLabelStyle {
    color: #dedee1;
    font-family: &quot;Segoe UI&quot;;
    font-size: 11px;
    font-weight: 600;
    background-color: transparent;
}
QWidget#linkErrorsCard, QFrame#inverte_code_table {
    background-color: #151515;
    border: 1px solid #2b2d31;
    border-radius: 14px;
}
QLabel#linkErrorsTitle {
    color: #9d9da1;
    font-family: &quot;Segoe UI&quot;;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 1px;
    background-color: transparent;
}
QWidget#l1_light, QWidget#l2_light, QWidget#l3_light, QWidget#l4_light {
    background-color: #eb2e25;
    border-radius: 15px;
}
QLabel#linkErrorText {
    color: #dfdfe2;
    font-family: &quot;Segoe UI&quot;;
    font-size: 11px;
    font-weight: 500;
    background-color: transparent;
}
QLabel#tableHeaderLabel {
    color: #4e9eff;
    font-family: &quot;Segoe UI&quot;;
    font-size: 13px;
    font-weight: 500;
    background-color: transparent;
}
QLabel#tableRowLabel {
    color: #ebebed;
    font-family: &quot;Segoe UI&quot;;
    font-size: 14px;
    font-weight: 600;
    background-color: transparent;
}
QLabel#tableRowValue {
    color: #ebebed;
    font-family: &quot;Segoe UI&quot;;
    font-size: 12px;
    font-weight: 600;
    background-color: transparent;
}
QFrame#tableLine1, QFrame#tableLine2, QFrame#tableLine3 {
    background-color: #24272d;
    border: none;
}
