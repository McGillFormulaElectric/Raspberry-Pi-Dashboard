    font-size: 16px;
    font-weight: bold;
    border-radius: 8px;
    border: 1px solid rgba(226, 75, 74, 80);
}
QFrame#bms_divider {
    background-color: rgba(255, 255, 255, 25);
}
QFrame#bmsCard1, QFrame#bmsCard2,
QFrame#bmsCard3, QFrame#bmsCard4,
QFrame#bmsCard5, QFrame#bmsCard6 {
    background-color: #161616;
