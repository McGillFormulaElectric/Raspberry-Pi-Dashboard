}
QLabel#thermalSectionTitle {
    color: #d1d5db;
    font-family: &quot;Segoe UI&quot;;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 1px;
    background: transparent;
    border: none;
}
QLabel#thermalSectionDot {
    color: #22c55e;
    font-family: &quot;Segoe UI&quot;;
    font-size: 18px;
