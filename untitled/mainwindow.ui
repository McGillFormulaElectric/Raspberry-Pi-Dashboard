    <widget class="QWidget" name="page_3">
     <property name="styleSheet">
      <string notr="true">
    QWidget#page_3 {
      background-color: #000000;
    }
    QWidget#batteryMonitorPage {
      background-color: #000000;
    }
    QFrame#packCard, QFrame#cellCard {
      background-color: #111111;
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 12px;
    }
    QLabel#headerTitle {
      color: #ffffff;
      font-family: Courier New;
      font-size: 11px;
      letter-spacing: 3px;
    }
    QLabel#packLabel, QLabel#cellLabel {
      color: #ffffff;
      font-family: Courier New;
      font-size: 11px;
      letter-spacing: 2px;
    }
    QLabel#packValue, QLabel#cellValue {
      color: #1D9E75;
      font-family: Courier New;
      font-size: 64px;
      font-weight: 500;
    }
    QLabel#packUnit, QLabel#cellUnit {
      color: rgba(255,255,255,0.5);
      font-family: Courier New;
      font-size: 20px;
    }
    QLabel#packBadge, QLabel#cellBadge {
      color: #1D9E75;
      background-color: rgba(29,158,117,0.15);
      font-family: Courier New;
      font-size: 10px;
      letter-spacing: 2px;
      border-radius: 4px;
      padding: 3px 8px;
    }
    QLabel#packMin, QLabel#packMax, QLabel#cellMin, QLabel#cellMax {
      color: #ffffff;
      font-family: Courier New;
      font-size: 11px;
    }
    QProgressBar#packBar, QProgressBar#cellBar {
      background-color: rgba(255,255,255,0.1);
      border: none;
      border-radius: 3px;
      height: 5px;
      text-align: center;
    }
    QProgressBar#packBar::chunk, QProgressBar#cellBar::chunk {
      background-color: #1D9E75;
      border-radius: 3px;
    }
    QLabel#footer {
      color: #ffffff;
      font-family: Courier New;
      font-size: 10px;
      letter-spacing: 3px;
    }
    QFrame#headerLine {
      color: rgba(255,255,255,0.15);
    }
      </string>
     </property>
