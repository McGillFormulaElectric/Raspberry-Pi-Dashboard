}
QLabel#motorFLValue, QLabel#motorFRValue, QLabel#motorRLValue, QLabel#motorRRValue,
QLabel#igbtFLValue, QLabel#igbtFRValue, QLabel#igbtRLValue, QLabel#igbtRRValue,
QLabel#coldPlateFLValue, QLabel#coldPlateFRValue, QLabel#coldPlateRLValue, QLabel#coldPlateRRValue {
