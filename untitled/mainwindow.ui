    <property name="styleSheet">
     <string notr="true">QMenuBar {
    background-color: black;
}

QMenuBar::item {
    color: white;
    background-color: black;
}

QMenuBar::item:selected {
    background-color: #333333;
}

QMenu {
    background-color: black;
    color: white;
}

QMenu::item:selected {
    background-color: #444444;
}
</string>
