    <widget class="QWidget" name="page_10">
     <property name="styleSheet">
      <string notr="true">/* ===== Root ===== */
QWidget#page_10 {
    background-color: #000000;
}

/* ===== Card panels ===== */
QFrame#cardSpeed,
QFrame#cardTirePSI,
QFrame#cardBrake,
QFrame#cardThrottle {
    background-color: #000000;
    border: none;
    border-radius: 8px;
}

QFrame#cardTireTemp {
    background-color: #000000;
    border: none;
    border-radius: 8px;
}

QFrame#cardPitMode {
    background-color: #FF1F1F;
    border: none;
    border-radius: 8px;
}

/* ===== Section headers ===== */
QLabel#tireTempHeader,
QLabel#tirePSIHeader,
QLabel#maxCellHeader,
QLabel#socHeader {
    color: rgba(255, 255, 255, 140);
    font-family: &quot;Roboto&quot;, sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 3px;
    background: transparent;
    border: none;
}

QLabel#tireFLLabel,
QLabel#tireFRLabel,
QLabel#tireRLLabel,
QLabel#tireRRLabel,
QLabel#psiFLLabel,
QLabel#psiFRLabel,
QLabel#psiRLLabel,
QLabel#psiRRLabel {
    color: rgba(255, 255, 255, 89);
    font-family: &quot;Roboto&quot;, sans-serif;
    font-size: 11px;
    letter-spacing: 1px;
    background: transparent;
    border: none;
}

/* ===== Tire temp / PSI numbers ===== */
QLabel#tireFLValue,
QLabel#tireFRValue {
    color: #EF9F27;
    font-family: &quot;Roboto Mono&quot;, &quot;Courier New&quot;, monospace;
    font-size: 34px;
    font-weight: 500;
    background: transparent;
    border: none;
}

QLabel#tireRLValue,
QLabel#tireRRValue {
    color: #E24B4A;
    font-family: &quot;Roboto Mono&quot;, &quot;Courier New&quot;, monospace;
    font-size: 34px;
    font-weight: 500;
    background: transparent;
    border: none;
}

QLabel#psiFLValue,
QLabel#psiFRValue,
QLabel#psiRLValue,
QLabel#psiRRValue {
    color: #FFFFFF;
    font-family: &quot;Roboto Mono&quot;, &quot;Courier New&quot;, monospace;
    font-size: 36px;
    font-weight: 500;
    background: transparent;
    border: none;
}

/* ===== Speed ===== */
QLabel#speedValue {
    color: #FFFFFF;
    font-family: &quot;Roboto Mono&quot;, &quot;Courier New&quot;, monospace;
    font-size: 200px;
    font-weight: 500;
    background: transparent;
    border: none;
}

QLabel#speedUnit {
    color: rgba(255, 255, 255, 128);
    font-family: &quot;Roboto&quot;, sans-serif;
    font-size: 15px;
    letter-spacing: 4px;
    background: transparent;
    border: none;
}

/* ===== Max Cell / SoC ===== */
QLabel#maxCellValue {
    color: #1D9E75;
    font-family: &quot;Roboto Mono&quot;, &quot;Courier New&quot;, monospace;
    font-size: 32px;
    font-weight: 500;
    background: transparent;
    border: none;
}

QLabel#socValue {
    color: #1D9E75;
    font-family: &quot;Roboto Mono&quot;, &quot;Courier New&quot;, monospace;
    font-size: 30px;
    font-weight: 500;
    background: transparent;
    border: none;
}

/* ===== Scale labels ===== */
QLabel#scaleLabel0,
QLabel#scaleLabel15,
QLabel#scaleLabel30 {
    color: rgba(255, 255, 255, 102);
    font-family: &quot;Roboto Mono&quot;, &quot;Courier New&quot;, monospace;
    font-size: 16px;
    background: transparent;
    border: none;
}

QLabel#scaleLabel45 {
    color: rgba(239, 159, 39, 230);
    font-family: &quot;Roboto Mono&quot;, &quot;Courier New&quot;, monospace;
    font-size: 16px;
    background: transparent;
    border: none;
}

QLabel#scaleLabel60,
QLabel#scaleLabelDQ {
    color: #E24B4A;
    font-family: &quot;Roboto Mono&quot;, &quot;Courier New&quot;, monospace;
    font-size: 16px;
    font-weight: 500;
    background: transparent;
    border: none;
}

/* ===== Pit mode ===== */
QLabel#pitModeLabel {
    color: #000000;
    font-family: &quot;Roboto&quot;, sans-serif;
    font-size: 36px;
    font-weight: 500;
    letter-spacing: 9px;
    background: transparent;
    border: none;
}

/* ===== Pedal labels ===== */
QLabel#brakeLabel,
QLabel#throttleLabel {
    color: rgba(255, 255, 255, 153);
    font-family: &quot;Roboto&quot;, sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 3px;
    background: transparent;
    border: none;
}

/* ===== Separators ===== */
QFrame#tireTempSep,
QFrame#psiSep {
    background-color: rgba(255, 255, 255, 31);
    border: none;
    max-height: 1px;
    min-height: 1px;
}

/* ===== Progress bars ===== */
QProgressBar#maxCellBar {
    background-color: #000000;
    border: 1px solid #EF9F27;
    border-radius: 4px;
    text-align: center;
    color: transparent;
}
QProgressBar#maxCellBar::chunk {
    background-color: #1D9E75;
    border-radius: 3px;
}

QProgressBar#socBar {
    background-color: #000000;
    border: 1px solid #EF9F27;
    border-radius: 3px;
    text-align: center;
    color: transparent;
}
QProgressBar#socBar::chunk {
    background-color: #1D9E75;
    border-radius: 2px;
}

QProgressBar#brakeBar {
    background-color: #000000;
    border: 1px solid #EF9F27;
    border-radius: 4px;
    text-align: center;
    color: transparent;
}
QProgressBar#brakeBar::chunk {
    background-color: #E24B4A;
    border-radius: 3px;
}

QProgressBar#throttleBar {
    background-color: #000000;
    border: 1px solid #EF9F27;
    border-radius: 4px;
    text-align: center;
    color: transparent;
}
QProgressBar#throttleBar::chunk {
    background-color: #1D9E75;
    border-radius: 3px;
}
</string>
