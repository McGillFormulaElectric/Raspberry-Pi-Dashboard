    <widget class="QWidget" name="page_2">
     <property name="styleSheet">
      <string notr="true">
QWidget#page_2 {
    background-color: #0a0a0a;
}
QLabel#bms_title {
    color: #f0f0f0;
    font-family: &quot;Courier New&quot;;
    font-size: 16px;
    font-weight: bold;
    background-color: transparent;
}
QLabel#bms_subtitle {
    color: #555555;
    font-family: &quot;Courier New&quot;;
    font-size: 16px;
    background-color: transparent;
}
QLabel#dotCharging, QLabel#dotBalancing {
    color: #E24B4A;
    font-size: 16px;
    background-color: transparent;
}
QLabel#statusChargingLabel, QLabel#statusBalancingLabel {
    color: #aaaaaa;
    font-family: &quot;Courier New&quot;;
    font-size: 16px;
    background-color: transparent;
}
QLabel#badgeCharging, QLabel#badgeBalancing {
    background-color: rgba(226, 75, 74, 40);
    color: #E24B4A;
    font-family: &quot;Courier New&quot;;
    font-size: 16px;
    font-weight: bold;
    border-radius: 8px;
    border: 1px solid rgba(226, 75, 74, 80);
}
QFrame#bms_divider {
    background-color: rgba(255, 255, 255, 25);
}
QFrame#bmsCard1, QFrame#bmsCard2,
QFrame#bmsCard3, QFrame#bmsCard4,
QFrame#bmsCard5, QFrame#bmsCard6 {
    background-color: #161616;
    border: 1px solid rgba(255, 255, 255, 30);
    border-radius: 8px;
}
QLabel#lblCurrent, QLabel#lblVoltage,
QLabel#lblMinTemp, QLabel#lblMaxTemp,
QLabel#lblMinVolt, QLabel#lblMaxVolt {
    color: #555555;
    font-family: &quot;Courier New&quot;;
    font-size: 12px;
    background-color: transparent;
}
QLabel#valCurrent, QLabel#valVoltage,
QLabel#valMinTemp, QLabel#valMaxTemp,
QLabel#valMinVolt, QLabel#valMaxVolt {
    color: #f0f0f0;
    font-family: &quot;Courier New&quot;;
    font-size: 26px;
    font-weight: bold;
    background-color: transparent;
}
      </string>
