    background-color: transparent;
}
QLabel#valCurrent, QLabel#valVoltage,
QLabel#valMinTemp, QLabel#valMaxTemp,
QLabel#valMinVolt, QLabel#valMaxVolt {
    color: #f0f0f0;
    font-family: "Courier New";
    font-size: 26px;
    font-weight: bold;
    background-color: transparent;
}
